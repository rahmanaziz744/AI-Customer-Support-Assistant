# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used by every agent node. Per-node overrides below are optional.
AGENT_MODEL=claude-opus-5
# Effort trades reasoning depth against latency/cost: low | medium | high | xhigh | max
AGENT_EFFORT=medium
# Cheaper/faster model for the classification node (optional, defaults to AGENT_MODEL)
CLASSIFIER_MODEL=
# Model used as judge in the eval suite (optional, defaults to AGENT_MODEL)
JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# Escalate to a human when the classifier's confidence falls below this.
ESCALATION_CONFIDENCE_THRESHOLD=0.65
# Escalate when the best retrieved policy chunk scores below this cosine similarity.
ESCALATION_RETRIEVAL_THRESHOLD=0.35
# Hard ceiling on any single auto-proposed refund, in USD. Above this always escalates.
MAX_AUTO_REFUND_USD=500
# Number of policy chunks fed to the drafting node.
RETRIEVAL_TOP_K=4

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Traces are always written to Postgres. Setting these additionally streams to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

LOG_LEVEL=INFO
# json for production, console for readable local dev
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Rate limit applied to ticket submission.
RATE_LIMIT_TICKETS=20/minute
CORS_ORIGINS=http://localhost:5173
