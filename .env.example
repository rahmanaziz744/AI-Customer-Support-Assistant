# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used by every agent node. Per-node overrides below are optional.
AGENT_MODEL=claude-opus-5
# Effort trades reasoning depth against latency/cost: low | medium | high | xhigh | max
AGENT_EFFORT=medium
# Cheaper/faster model for the classification node (optional, defaults to AGENT_MODEL)
CLASSIFIER_MODEL=
# Model used as judge in the eval suite (optional, defaults to AGENT_MODEL)
JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# Escalate to a human when the classifier's confidence falls below this.
ESCALATION_CONFIDENCE_THRESHOLD=0.65
# Escalate when the best retrieved policy chunk scores below this cosine similarity.
ESCALATION_RETRIEVAL_THRESHOLD=0.35
# Hard ceiling on any single auto-proposed refund, in USD. Above this always escalates.
MAX_AUTO_REFUND_USD=500
# Number of policy chunks fed to the drafting node.
RETRIEVAL_TOP_K=4

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# Traces are always written to Postgres. Setting these additionally streams to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-agent

LOG_LEVEL=INFO
# json for production, console for readable local dev
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Rate limits are per client IP. Semicolon-separated windows are enforced
# together: the short one stops bursts, the long one stops a slow drip that
# would still drain the model budget overnight.
# Ticket submission.
RATE_LIMIT_TICKETS=20/minute;300/hour;1000/day
# Routes that trigger model work on an existing ticket (process, approve,
# reject) and the destructive delete.
RATE_LIMIT_EXPENSIVE=10/minute;100/hour;400/day
# Fallback for every other route. Empty disables it.
RATE_LIMIT_DEFAULT=240/minute
# How many proxies in front of this process append to X-Forwarded-For. 0 when
# exposed directly. Set to 2 behind the deployed Caddy -> nginx chain, or the
# rate limiter keys every request to the proxy and shares one bucket.
TRUSTED_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------------
# Rolling 24h ceiling on model spend, in USD. Once reached, submitting a ticket
# for processing, running the agent, and approving a draft are refused with 429
# until older spend ages out of the window; reads stay available. 0 disables
# enforcement, which is the default so local dev is unaffected.
#
# This is the innermost of three limits. Also set MAX_CONCURRENT_RUNS below,
# and — the only ceiling an application bug cannot bypass — a spend limit on
# the Anthropic workspace the deployed key belongs to.
DAILY_BUDGET_USD=0
# Fraction of the ceiling that counts as "warn", reported on the budget
# snapshot log line for alarms to watch.
BUDGET_WARN_RATIO=0.6
# How long a spend reading is reused before re-querying, in seconds.
BUDGET_CACHE_SECONDS=15
# Interval between budget_snapshot log lines. 0 disables them.
BUDGET_SNAPSHOT_SECONDS=60
# Agent runs allowed to execute at once. Submission returns immediately and
# hands the run to a background task, so without this a burst of tickets
# becomes a burst of concurrent graph runs.
MAX_CONCURRENT_RUNS=2

# ---------------------------------------------------------------------------
# Demo protection
# ---------------------------------------------------------------------------
# Shared secret required in the X-Demo-Token header to delete a ticket. Empty
# leaves deletion open, which is what local dev wants. Set it on any public
# deployment so a passer-by cannot wipe the seeded demo data.
DEMO_ADMIN_TOKEN=
