# Terraform. State is ignored because it holds the generated Postgres password;
# it belongs in the encrypted S3 backend, not in git. .terraform.lock.hcl is
# deliberately NOT ignored — commit it so everyone resolves the same provider
# versions.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/backend.hcl
!terraform/*.tfvars.example
# Saved plans embed the same generated secrets the state does, in cleartext.
terraform/*.tfplan
terraform/tfplan.out
